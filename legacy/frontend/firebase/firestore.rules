rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // Mentors catalog (publicly readable by signed-in users, updated via admin or verified accounts)
    match /mentors/{mentorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == mentorId;

      match /slots/{slotId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated();
      }
    }

    // Evidence bank items
    match /evidences/{evidenceId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Bookings & Orders
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.coacheeId == request.auth.uid || 
        resource.data.mentorId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.coacheeId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.coacheeId == request.auth.uid || 
        resource.data.mentorId == request.auth.uid
      );
    }

    // Peer Circle Community posts & cheers
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated(); // For cheers and comments
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
    }

    // Reports collection
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if false; // Admin-only review
    }

    // Chat conversations with AI Coach
    match /conversations/{userId}/messages/{messageId} {
      allow read, write: if isOwner(userId);
    }

    // Tasks & Plans
    match /plans/{userId} {
      allow read, write: if isOwner(userId);
    }
  }
}