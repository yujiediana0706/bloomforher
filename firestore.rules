rules_version = '2';

// ReBloom AI — Firestore security rules
//
// Security design notes:
// - Sensitive aggregate data (evidence, bookings, transactions, reviews) can never be written
//   directly by the client; it all goes through server APIs (admin SDK).
// - A user's private profile users/{uid} is readable only by the owner; the fields exposed to the
//   community are mirrored into publicProfiles/{uid} (read-only for signed-in users).
// - The plazaPosts main document does not contain authorId (authorId lives in the private/meta
//   sub-document, readable only by the author), so an anonymous post's author identity cannot be
//   read by other users; the willingToHelp list is readable only by the post owner.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // --- User profiles ---
    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    // Community public profiles (public fields such as name/bio/skills/coffeeAvailability/communityAgreed)
    match /publicProfiles/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid);
    }

    // --- AI journey outputs: owner only ---
    match /skillProfiles/{uid} {
      allow read, write: if isSelf(uid);
    }
    match /opportunityReports/{uid} {
      allow read, write: if isSelf(uid);
    }
    match /returnPlans/{uid} {
      allow read, write: if isSelf(uid);
    }
    match /planTasks/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /labTasks/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // --- Evidence vault: owner-readable only, all writes go through the API ---
    match /evidences/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // --- Talk Plaza ---
    match /plazaPosts/{postId} {
      // The main document has no authorId; readable by any signed-in user
      allow read: if signedIn();
      allow write: if false; // posting / commenting / kudos all go through the API

      match /comments/{cid} {
        allow read: if signedIn();
        allow write: if false;
      }

      // Only the post owner can read the list of helpers
      match /willingToHelp/{uid} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/plazaPosts/$(postId)/private/meta).data.authorId == request.auth.uid;
        allow write: if false;
      }

      // Author identity private mapping: readable only by the owner
      match /private/{docId} {
        allow read: if signedIn() && resource.data.authorId == request.auth.uid;
        allow write: if false;
      }
    }

    // --- Peer Coffee Chat: readable only by the two parties ---
    match /peerChats/{id} {
      allow read: if signedIn() &&
        (resource.data.requesterId == request.auth.uid || resource.data.helperId == request.auth.uid);
      allow write: if false;
    }

    // --- Mentor marketplace: public read-only (a mentor document never contains a meetingLink) ---
    match /mentors/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /mentorSlots/{id} {
      allow read: if true;   // slot display
      allow write: if false; // booking transactions go through the API
    }

    // --- Transactions and reviews: readable by the relevant parties only, all writes go through the API ---
    match /bookings/{id} {
      allow read: if signedIn() &&
        (resource.data.coacheeId == request.auth.uid || resource.data.mentorUserId == request.auth.uid);
      allow write: if false;
    }
    match /packageOrders/{id} {
      allow read: if signedIn() && resource.data.coacheeId == request.auth.uid;
      allow write: if false;
    }
    match /reviews/{id} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /endorsements/{id} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --- Generic circles ---
    match /posts/{postId} {
      allow read: if signedIn();
      // The author can write directly via rules; all other cases go through the API
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }
    match /kudos/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if false;
    }
    match /reports/{id} {
      allow create: if signedIn();
      allow read: if false;
    }

    // --- AI Coach conversation history: owner only ---
    match /conversations/{uid} {
      allow read, write: if isSelf(uid);
      match /messages/{mid} {
        allow read, write: if isSelf(uid);
      }
    }
  }
}
