rules_version = '2';

// ReBloom AI — Cloud Storage rules
// resumes/{uid}/**: owner read/write only (resume / certificate files are private)
// docs/{uid}/**   : owner read/write only (credential materials, etc.)
service firebase.storage {
  match /b/{bucket}/o {
    match /resumes/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /docs/{uid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
