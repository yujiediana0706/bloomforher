# ReBloom AI — environment variable example
# Copy this file to .env.local and fill in the real values.
# Only placeholders are shown here; never commit real secrets.

# ---- Google Cloud / Firebase project identifiers ----
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- Agent Platform endpoints (5 Reasoning Engines) ----
# Created in GCP Agent Studio; the system prefers these and falls back to a
# direct Vertex AI Gemini 3.5 Flash call when an agent is unavailable.
# Format: projects/{project}/locations/{location}/reasoningEngines/{id}

# Assessment agent (onboarding assessment flow)
AGENT_ENDPOINT_ASSESSMENT=
# Coach agent (core chat on the /coach page)
AGENT_ENDPOINT_COACH=
# Memory agent (called internally by the coach, not user-facing)
AGENT_ENDPOINT_MEMORY=
# Proactive agent (scheduled background pushes)
AGENT_ENDPOINT_PROACTIVE=
# Mentor-match agent (mentor community page)
AGENT_ENDPOINT_MENTOR_MATCH=

# ---- Server secrets ----
# HMAC secret used to sign session cookies. Required in production.
AUTH_SECRET=change-me-to-a-long-random-string

# Service-account key path. Local development only.
# On Cloud Run the metadata server provides Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
