# 「ReBloom AI · 她径」环境变量示例
# 复制为 .env.local 并按 Firebase 控制台 → 项目设置 → 应用 中填入真实值。

# —— 浏览器端公开配置（NEXT_PUBLIC_ 前缀会打包进前端）——
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=rebloom-cup.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=rebloom-cup
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=rebloom-cup.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# —— 服务端密钥 ——
# Google AI Studio 申请（现阶段：AI 未接入，可留空）
GEMINI_API_KEY=

# —— 种子脚本 ——
# 服务账号私钥路径（Firebase 控制台 → 项目设置 → 服务账号 → 生成新的私钥）
# 也可使用 GOOGLE_APPLICATION_CREDENTIALS
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
FIREBASE_PROJECT_ID=rebloom-cup
